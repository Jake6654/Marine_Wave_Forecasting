FROM ghcr.io/astral-sh/uv:0.10.10 AS uv
FROM python:3.13-slim

COPY --from=uv /uv /uvx /bin/
WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH"

# slim 이미지에서도 TLS 검증과 Asia/Seoul 시간대 해석을 보장한다.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates tzdata \
    && apt-get clean

# 인증키와 관측 DB는 빌드 컨텍스트 및 이미지에 넣지 않는다.
COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY scripts ./scripts
RUN uv sync --locked --no-dev --no-editable
RUN useradd --uid 10001 --create-home collector \
    && mkdir -p /var/lib/marine-forecast \
    && chown collector:collector /var/lib/marine-forecast
USER collector

CMD ["python", "scripts/run_buoy_collector.py", "--db", "/var/lib/marine-forecast/buoy_observations.sqlite3"]
