# 실제 키는 .env에만 저장하고 Git에 추가하지 않는다.
KMA_API_KEY=

# 수동 수집을 사용할 때 Next.js 서버와 동일한 32자 이상 무작위 토큰을 설정한다.
MARINE_COLLECTION_TOKEN=

# API는 이 파일을 자동으로 읽지 않는다. 서버 실행 전 필요한 설정만 export한다.
# 직접 생성하고 신뢰하는 로컬 모델을 사용할 때만 true로 바꾼다.
MARINE_API_TRUST_LOCAL_MODEL=false
# QC 미확인 상태를 허용하는 학습·시연 전용 옵션이다.
MARINE_API_ALLOW_UNVERIFIED_SOURCE=false
MARINE_API_MAX_AGE_MINUTES=90
# 기본 경로를 바꿀 때만 아래 항목을 설정한다.
# MARINE_API_DB_PATH=/absolute/path/to/buoy_observations.sqlite3
# MARINE_API_MODEL_PATH=/absolute/path/to/rf_22101_v1
